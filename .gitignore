# Generated logs in any directory (keep directory protection files)
**/logs/*
!**/logs/index.html
!**/logs/.htaccess

# CodeIgniter daily logs, including custom log locations
log-[0-9]*.php

# Runtime logs and rotated log files anywhere in the project
*.log
*.log.*
*.log-*
error_log
error_log.*
error_log-*
access_log
access_log.*
access_log-*
